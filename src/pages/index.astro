---
import { actions } from 'astro:actions';

type FormInfo = {
	id: string
}

const result = Astro.getActionResult(actions.pasteInfo);

if (result && !result.error) {
	const pasteId = result.data as FormInfo;
	console.log(pasteId.id)
  	return Astro.redirect(`/paste/${pasteId.id}`);
}

import Layout from '../layouts/Layout.astro';
---

<Layout title="Based Bin">
	<header>
		<h1>Based Bin</h1>
	</header>
	<main class="container-fluid">
		<form method="post" action={actions.pasteInfo}>
			<fieldset>
				<textarea name="paste" placeholder="Paste your stuff here" class="textarea" rows="30" />
				<input type="submit" value="Submit"></input>
			</fieldset>
		</form>
	</main>
</Layout>